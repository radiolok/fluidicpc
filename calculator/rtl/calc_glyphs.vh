// Образы символов 5×7 для тестбенчей. Сгенерировано model/gen_testbenches.py.
// Бит r*5+c — строка r сверху, столбец c слева; 1 — пиксель силуэта.
function [34:0] glyph;
    input [7:0] c;
    begin
        case (c)
            "0": glyph = 35'b01110100011001110101110011000101110;
            "1": glyph = 35'b01110001000010000100001000011000100;
            "2": glyph = 35'b11111000100010001000100001000101110;
            "3": glyph = 35'b01110100011000001000001000100011111;
            "4": glyph = 35'b01000010001111101001010100110001000;
            "5": glyph = 35'b01110100011000010000011110000111111;
            "6": glyph = 35'b01110100011000101111000010001001100;
            "7": glyph = 35'b00010000100001000100010001000011111;
            "8": glyph = 35'b01110100011000101110100011000101110;
            "9": glyph = 35'b00110010001000011110100011000101110;
            "+": glyph = 35'b00000001000010011111001000010000000;
            "-": glyph = 35'b00000000000000011111000000000000000;
            "x": glyph = 35'b00000100010101000100010101000100000;
            "=": glyph = 35'b00000000001111100000111110000000000;
            "C": glyph = 35'b01110100010000100001000011000101110;
            default: glyph = 35'b0;
        endcase
    end
endfunction
